# Copy this file to ".env" (same folder) and paste your keys after the = signs.
# .env is never committed and never sent to the browser. Restart "npm run dev"
# after changing it, then run "npm run ai:check" to test the keys.

# --- Yuuki's AI (free models). One key is enough; more = fallbacks. ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Which free models to use (defaults shown; run "npm run ai:check" to list others)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.1-flash-lite
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_FALLBACKS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Order Yuuki tries them in when one is busy or out of free quota
# AI_PROVIDER_ORDER=groq,openrouter,gemini

# --- Server (optional) ---
# STUDYSYNC_PORT=8787

# --- Plans (Free / Plus / Pro) ---
# There is no payment provider yet. For a class demo, "true" shows a plan
# switch in Settings so you can show Plus and Pro features. Leave it off for
# anything real. You can also run: npm run plan -- <username> plus
# STUDYSYNC_DEMO_PLANS=true

# --- Online (Render) ---
# Any long random string; signs logins so they stay valid across restarts
# STUDYSYNC_SECRET=
# Fill this demo account with a sample semester when the server starts empty
# STUDYSYNC_SEED_DEMO=jelly
